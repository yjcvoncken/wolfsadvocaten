# Set these in Railway Variables; this file is documentation, not loaded automatically.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Optional with a Railway volume: without DATABASE_URL, SQLite is stored on the volume.
# Recommended: add PostgreSQL and reference its DATABASE_URL in the website service.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Railway supplies RAILWAY_PUBLIC_DOMAIN and RAILWAY_VOLUME_MOUNT_PATH automatically.
# Add any custom website domain here (comma-separated, without https://).
# DJANGO_ALLOWED_HOSTS=www.example.com,example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.example.com,https://example.com
# Optional initial administrator. Remove the password variable after first successful startup.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=you@example.com
# DJANGO_SUPERUSER_PASSWORD=set-in-railway-only

# Contact form email: set these variables in Railway (or the process environment).
EMAIL_HOST=smtp.your-mail-provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=info@wolfsadvocaten.nl
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Wolfs Advocaten <info@wolfsadvocaten.nl>
